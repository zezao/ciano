#!/bin/sh
# Enforce commit subject format: <type>: <lowercase summary>
# Types: doc:, feat:, fix:
# Install with: make hooks

subject=$(head -n 1 "$1")

# Allow Git-generated messages and interactive-rebase markers.
case "$subject" in
  "Merge "?* | "Revert "?* | "fixup! "?* | "squash! "?* | "amend! "?*)
    exit 0
    ;;
esac

case "$subject" in
  "doc: "?* | "feat: "?* | "fix: "?*)
    ;;
  *)
    printf 'error: commit subject must start with doc:, feat:, or fix:\n' >&2
    printf '  got: %s\n' "$subject" >&2
    printf '  see AGENTS.md for the commit message format\n' >&2
    exit 1
    ;;
esac

summary=${subject#*: }

case "$summary" in
  [abcdefghijklmnopqrstuvwxyz]*)
    ;;
  *)
    printf 'error: commit summary must start with a lowercase letter:\n' >&2
    printf '  got: %s\n' "$summary" >&2
    printf '  see AGENTS.md for the commit message format\n' >&2
    exit 1
    ;;
esac

case "$subject" in
  *.)
    printf 'error: commit subject must not end with a period:\n' >&2
    printf '  got: %s\n' "$subject" >&2
    printf '  see AGENTS.md for the commit message format\n' >&2
    exit 1
    ;;
esac
